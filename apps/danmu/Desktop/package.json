{
  "name": "feishu-danmu-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "飞书未读消息桌面弹幕",
  "main": "main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack:mac": "electron-builder --mac dmg --arm64 --x64",
    "pack:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.zaizhi.feishu-danmu.team",
    "productName": "飞书弹幕",
    "directories": {
      "output": "../release/packages"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "core/**",
      "ui/**"
    ],
    "extraResources": [
      {
        "from": "vendor/${os}-${arch}",
        "to": "cli"
      },
      {
        "from": "../Assets/dazai-dossier.png",
        "to": "dazai-dossier.png"
      },
      {
        "from": "../使用说明.html",
        "to": "使用说明.html"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "identity": "-",
      "icon": "vendor/AppIcon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "ui/app-icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "artifactName": "feishu-danmu-${version}-windows-${arch}-setup.${ext}"
    },
    "dmg": {
      "artifactName": "feishu-danmu-${version}-mac-${arch}.${ext}"
    }
  }
}
